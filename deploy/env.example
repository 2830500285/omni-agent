OMNI_AGENT_WEB3_RPC_URL=
OMNI_AGENT_TRONSCAN_BASE_URL=https://ts.bankofai.io
TRONSCAN_API_KEY=
OMNI_AGENT_TRON_FULL_NODE_URL=https://hptg.bankofai.io
